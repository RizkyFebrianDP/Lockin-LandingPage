{
  "name": "lockin-landingpage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "ANALYZE=true npm run build",
    "build:production": "NODE_ENV=production next build",
    "performance:audit": "lighthouse http://localhost:3000 --output=html --output-path=./performance-audit.html",
    "performance:test": "npm run build && npm run start & sleep 5 && npm run performance:audit && pkill -f 'next start'",
    "bundle:analyze": "npx @next/bundle-analyzer",
    "cache:clear": "rm -rf .next && rm -rf node_modules/.cache",
    "optimize:images": "npx next-optimized-images",
    "lint:performance": "npx eslint . --ext .ts,.tsx --config .eslintrc.performance.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "critters": "^0.0.24",
    "lighthouse": "^12.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "web-vitals": "^4.2.4"
  }
}
